# Este repositorio se desarrolla con DAW, así que lleva el mismo bloque que el
# instalador escribe en cualquier otro — con los mismos marcadores, para que un
# `install.sh` corrido acá lo reconozca en vez de agregar una segunda copia.
*.pyc
__pycache__/

# BEGIN DAW — pipeline runtime, NOT committed (managed by DAW)
#   .daw-state.json  = which phase you are in; yours, not the repo's
#   .daw-paused/     = paused tickets
#   .daw-sessions/   = live session markers
#   .daw-work/       = scratch the pipeline writes and re-reads (the commit message)
#   .daw-journal.jsonl = transitions that landed; outlives the state file
#   .daw/**/__pycache__/ = bytecode from running the method's own scripts
.daw-state.json
.daw-paused/
.daw-sessions/
.daw-work/
.daw-journal.jsonl
.daw/**/__pycache__/
# END DAW

# Salida cruda del mapa de kills. `kill_map_ledger.py` la escribe en el
# directorio donde lo corras, así que corrido desde la raíz aterriza acá — y así
# fue como una medición de agosto quedó commiteada dieciocho pull requests,
# siendo exactamente lo que el libro que produce advierte en su primer párrafo.
kill-map-merged.json
kill-map-*.json
