{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": ".cursor/hooks/daw/session-start.sh",
        "timeout": 15
      }
    ],
    "preToolUse": [
      {
        "command": ".cursor/hooks/daw/pre-tool-use.sh",
        "matcher": "Write|Delete|Shell",
        "failClosed": true,
        "timeout": 15
      }
    ],
    "postToolUse": [
      {
        "command": ".cursor/hooks/daw/post-write.sh",
        "matcher": "Write|Delete|Shell",
        "failClosed": true,
        "timeout": 15
      }
    ],
    "preCompact": [
      {
        "command": ".cursor/hooks/daw/pre-compact.sh",
        "timeout": 10
      }
    ]
  }
}
